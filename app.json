{
  "expo": {
    "name": "AI Hat",
    "slug": "ai-hat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aihat",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.amanm.aihat",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amanm.aihat",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C6F46B"
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AI Hat to use the microphone for dictation and translation."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Hat to attach photos to messages.",
          "cameraPermission": "Allow AI Hat to take photos to attach to messages."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AI Hat to lock the app with Face ID."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
